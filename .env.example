# Copy this file to .env and fill in what you have. Every key is optional:
# with nothing set, the app runs in DEMO MODE (mock PayPal + built-in rules).

# ---- PayPal (free sandbox app from https://developer.paypal.com/dashboard/applications/sandbox) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ---- AI: set ONE of these keys. AI_PROVIDER=auto picks whichever is set. ----
# Free option: Google Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or OpenAI:
OPENAI_API_KEY=
# Or Groq (free tier): GROQ_API_KEY=
# Or any OpenAI-compatible API (Ollama, OpenRouter, Together...):
# AI_PROVIDER=custom
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.1
AI_PROVIDER=auto
# Optional model override, e.g. gemini-3.8-flash or gpt-4.1-mini
AI_MODEL=

# ---- App ----
BUSINESS_NAME=My Freelance Studio
DEFAULT_CURRENCY=USD
# Optional: require a password to open the dashboard (pay pages stay public)
APP_PASSWORD=
PORT=3000
